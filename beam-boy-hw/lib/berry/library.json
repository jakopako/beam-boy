{
  "name": "berry",
  "version": "1.1.0",
  "description": "Berry scripting language, vendored and trimmed for Beam Boy cartridges (see docs/phase-5-vm-bakeoff.md).",
  "repository": {
    "type": "git",
    "url": "https://github.com/berry-lang/berry"
  },
  "license": "MIT",
  "frameworks": "arduino",
  "platforms": "espressif32",
  "build": {
    "includeDir": "generate",
    "srcDir": "src",
    "srcFilter": [
      "+<*.c>",
      "+<*.cpp>",
      "-<be_filelib.c>"
    ],
    "flags": [
      "-DCOMPILE_BERRY_LIB"
    ]
  }
}
